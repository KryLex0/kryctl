  echo "To restart multipass: 'sudo snap restart multipass.multipassd'"

  multipass list

  echo "multipass set local.driver=qemu || multipass set local.driver=lxd"

  create_instance() {
      # while getopts i:n:d:r: flag
      # do
      #     case "${flag}" in
      #         i) image=${OPTARG};;
      #         n) name=${OPTARG};;
