    exit 1
  fi
  if [[ -z ${args['--file']+x} ]]; then
    printf "missing required flag: --file, -f FILE\n" >&2
    exit 1
  fi

}

# :command.parse_requirements
kryctl_s3_delete_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        kryctl_s3_delete_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="s3 delete"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --bucket-path | -b)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--bucket-path']="$2"
          shift
          shift
        else
          printf "%s\n" "--bucket-path requires an argument: --bucket-path, -b BUCKET-PATH" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --file | -f)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--file']="$2"
          shift
          shift
        else
          printf "%s\n" "--file requires an argument: --file, -f FILE" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --profile | -p)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--profile']="$2"
          shift
          shift
        else
          printf "%s\n" "--profile requires an argument: --profile, -p PROFILE" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"
          # :command.parse_requirements_case
          # :command.parse_requirements_case_simple
          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  # :command.required_flags_filter
  if [[ -z ${args['--bucket-path']+x} ]]; then
    printf "missing required flag: --bucket-path, -b BUCKET-PATH\n" >&2
    exit 1
  fi

}

# :command.initialize
initialize() {
  declare -g version="0.1.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "completions") kryctl_completions_command ;;
    "terminal") kryctl_terminal_command ;;
    "terminal change") kryctl_terminal_change_command ;;
    "git") kryctl_git_command ;;
    "git stash") kryctl_git_stash_command ;;
    "space") kryctl_space_command ;;
    "space clear") kryctl_space_clear_command ;;
    "kube") kryctl_kube_command ;;
    "kube context") kryctl_kube_context_command ;;
    "kube find") kryctl_kube_find_command ;;
    "kube set-config") kryctl_kube_set_config_command ;;
    "multipass") kryctl_multipass_command ;;
    "s3") kryctl_s3_command ;;
    "s3 profiles") kryctl_s3_profiles_command ;;
    "s3 ui") kryctl_s3_ui_command ;;
    "s3 get-size") kryctl_s3_get_size_command ;;
    "s3 ls") kryctl_s3_ls_command ;;
    "s3 list") kryctl_s3_list_command ;;
    "s3 download") kryctl_s3_download_command ;;
    "s3 sync") kryctl_s3_sync_command ;;
    "s3 upload") kryctl_s3_upload_command ;;
    "s3 delete") kryctl_s3_delete_command ;;
  esac
}

# :command.start
start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  start "$@"
fi
